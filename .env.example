# ──────────────────────────────────────────────────────────────────────────────
# Threadify — Environment Variable Template
# Copy this file to `.env` and fill in the real values.
# Never commit your real `.env` to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# ── Razorpay (Payments) ───────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
PLATFORM_COMMISSION_PERCENT=10

# ── OpenAI (AI Features) ──────────────────────────────────────────────────────
# Keep this server-side only — no NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=your_openai_api_key_here

# ── Cloudinary (Image Upload) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── Google Vision (Garment Analysis) ─────────────────────────────────────────
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# ── Cloudflare Workers AI (Production Vision Analysis) ─────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ── Google Analytics (Optional) ──────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Site URL (Production Only) ────────────────────────────────────────────────
# Set this to your deployed domain to fix mobile email confirmation links.
# Leave unset in local development — defaults to localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# ── Contact Email (Optional — for contact form notifications) ────────────────
# CONTACT_EMAIL=hello@threadify.in
